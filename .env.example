# Copy to .env and edit.
MEDLY_SECRET_KEY=change-me-to-a-long-random-string
MEDLY_DATABASE_URL=sqlite:///./medly.db
MEDLY_ACCESS_TOKEN_MINUTES=720
MEDLY_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Pattern for deploy-preview hostnames. Tighten this before production.
MEDLY_CORS_ORIGIN_REGEX=https://.*\.(up\.railway\.app|vercel\.app)

# Re-run the seed on boot. Idempotent, and it means a fresh container or a wiped
# volume comes up with the curriculum and demo accounts already present.
MEDLY_SEED_ON_STARTUP=false

# Assistant provider: "rules" needs no key and works offline (default).
# "anthropic" or "openai" require the matching key below.
MEDLY_ASSISTANT_PROVIDER=rules
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Inference engine: "mock" (default) or "onnx" once you supply weights.
MEDLY_INFERENCE_ENGINE=mock
MEDLY_ONNX_MODEL_PATH=

# Safety thresholds
MEDLY_LOW_CONFIDENCE_THRESHOLD=0.70
MEDLY_CERTIFICATION_PASS_SCORE=80
